{
  "id": "ca.swen.bettercaptions",
  "name": "S-Captions",
  "version": "0.7.100",
  "manifestVersion": 5,
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "betterCaptions",
      "label": {
        "default": "S-Captions"
      },
      "minimumSize": {
        "width": 330,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 440,
        "height": 800
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "webview": {
      "allow": "yes",
      "allowLocalRendering": "yes",
      "domains": [],
      "enableMessageBridge": "localAndRemote"
    }
  }
}
