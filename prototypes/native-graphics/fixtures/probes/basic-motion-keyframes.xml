<?xml version="1.0" encoding="UTF-8"?>
<!-- Public Basic Motion effectid basic, scale/center parameters, attached as a filter to a Text generator. -->
<xmeml version="5">
  <sequence id="bc-probe-basic-motion-1080p30-v1">
